<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG_MAUI_Car_Register.View.MainPage"
             Title="Registrera">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="30">

            <Label Text="Registrera"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center" />

            <Border Stroke="DarkRed"
                StrokeThickness="2"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <Entry Placeholder="Registreringsnummer"
                       Text="{Binding RegistrationNumber}"
                       FontSize="18" />

                    <Picker ItemsSource="{Binding VehicleTypes}"
                        SelectedItem="{Binding SelectedVehicleType}"
                        Title="Välj fordonstyp"
                        FontSize="18" />

                    <Entry Placeholder="Tillverkare"
                       Text="{Binding Manufacturer}"
                       FontSize="18" />

                    <Entry Placeholder="Modell"
                       Text="{Binding VehicleModel}"
                       FontSize="18" />

                    <Entry Placeholder="Årsmodell"
                       Keyboard="Numeric"
                       Text="{Binding YearModel}"
                       FontSize="18" />

                    <Button Text="Registrera"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        CornerRadius="10"
                        FontSize="18"
                        Command="{Binding RegisterCommand}" />

                </VerticalStackLayout>

            </Border>

            <Label Text="Sök fordon"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="DarkRed"
               HorizontalOptions="Center" />

            <Border Stroke="DarkRed"
                StrokeThickness="2"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <Entry Placeholder="Sök registreringsnummer"
                       Text="{Binding SearchTerm}"
                       FontSize="18" />

                    <Button Text="Sök"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        CornerRadius="10"
                        FontSize="18"
                        Command="{Binding SearchCommand}" />

                    <Label Text="{Binding SearchResult}"
                       TextColor="White"
                       FontAttributes="Italic"
                       FontSize="16" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
