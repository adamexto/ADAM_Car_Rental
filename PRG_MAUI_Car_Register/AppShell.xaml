<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PRG_MAUI_Car_Register.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PRG_MAUI_Car_Register.View"
    Shell.FlyoutBehavior="Flyout"
    Title="Car Register">

    <ShellContent 
        Title="Regristrera" 
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}" />

    <ShellContent 
        Title="Cars" 
        Route="CarPage"
        ContentTemplate="{DataTemplate local:CarPage}" />

    <ShellContent 
        Title="MC" 
        Route="MCPage"
        ContentTemplate="{DataTemplate local:MCPage}" />

    <ShellContent 
        Title="Trucks" 
        Route="TruckPage"
        ContentTemplate="{DataTemplate local:TruckPage}" />

</Shell>
